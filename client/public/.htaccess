# ----------------------------------------------------------------------
# Use this file ONLY when public_html = contents of client/dist/ (flat deploy).
# On Cloudways with the full repo in public_html, use /.htaccess at repo root.
# ----------------------------------------------------------------------

RewriteEngine On
RewriteBase /

# API -> Node
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^(.*)$ http://127.0.0.1:3001/$1 [P,L]

# React Router (static files like robots.txt and sitemap.xml are served as-is)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
