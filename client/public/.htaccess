<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Proxy all /api/* requests to the backend on port 3001
    RewriteRule ^api/(.*)$ http://127.0.0.1:3001/api/$1 [P,L]

    # 2. Canonical URLs: strip a trailing slash so /catalog/x/ and /catalog/x
    #    are not crawled as two separate pages. Directories are exempt.
    # TLS terminates upstream, so a relative target would redirect to http://
    # and cost an extra downgrade hop. Build the https URL explicitly.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 3. SPA Fallback: Serve the static file if it exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # 4. If it's not a static file and not an API request, serve index.html
    RewriteRule ^ index.html [QSA,L]
</IfModule>