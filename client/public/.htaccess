<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Proxy all /api/* requests to the backend on port 3001
    RewriteRule ^api/(.*)$ http://127.0.0.1:3001/api/$1 [P,L]

    # 2. Canonical URLs: strip a trailing slash so /catalog/x/ and /catalog/x
    #    are not crawled as two separate pages. Directories are exempt.
    # TLS terminates upstream, so a relative target would redirect to http://
    # and cost an extra downgrade hop. Build the https URL explicitly.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 3. Product detail pages are prerendered at build time as
    #    _parts/<slug>.html — one flat file per part that actually exists.
    #    The files live outside the /catalog namespace on purpose: a real
    #    "catalog" directory would make mod_dir redirect /catalog to /catalog/,
    #    which rule 2 strips back, looping forever.
    #    The slug pattern MUST STAY IN SYNC with isPrerenderableSlug in
    #    server/src/utils/prerender.ts: whatever this rule 404s on a miss must
    #    be exactly what the prerender writes on a hit. A slug outside the set
    #    matches neither rule and falls through to the SPA shell under 200 —
    #    the old behaviour, which is always safe. Matching the charset also
    #    keeps the rewritten _parts/<slug>.html (it has a dot) from re-entering
    #    this rule on the next pass and falling through to rule 4.
    RewriteCond %{DOCUMENT_ROOT}/_parts/$1.html -f
    RewriteRule ^catalog/([a-z0-9-]{1,120})$ /_parts/$1.html [L]

    # 4. Unknown part number: a real 404 instead of the SPA shell under HTTP
    #    200, which is exactly what Google classifies as a soft 404.
    #    Gated on the prerender marker: a deploy that could not reach the
    #    database (or a DOCUMENT_ROOT this rule cannot resolve) writes no
    #    marker, so this rule goes dormant and rule 5 keeps serving the shell
    #    rather than 404-ing every product page.
    RewriteCond %{DOCUMENT_ROOT}/_parts/.prerendered -f
    RewriteCond %{DOCUMENT_ROOT}/_parts/$1.html !-f
    RewriteRule ^catalog/([a-z0-9-]{1,120})$ - [R=404,L]

    # 4b. The prerendered shells are an implementation detail reachable only
    #     through rule 3. THE_REQUEST is the original request line and is not
    #     rewritten, so this blocks direct hits without touching rule 3's
    #     internal rewrite — no duplicate URL for the same page.
    RewriteCond %{THE_REQUEST} \s/_parts/ [NC]
    RewriteRule ^ - [R=404,L]

    # 5. SPA Fallback: Serve the static file if it exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # 6. If it's not a static file and not an API request, serve index.html
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# The 404 body is the SPA shell, so a missing part still renders the styled
# "Product not found" page (which carries noindex) — but under a 404 status
# instead of 200. Only rule 4 above reaches this.
ErrorDocument 404 /index.html

# The prerender marker is bookkeeping, not content.
<Files ".prerendered">
    Require all denied
</Files>

# No directory listing for the prerendered shells.
Options -Indexes
