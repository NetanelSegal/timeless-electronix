# ----------------------------------------------------------------------
# Cloudways Hybrid Stack — public_html is the REPO ROOT (not client/dist).
# Site build output lives in client/dist/ (index.html, sitemap.xml, assets).
# Place this file in public_html next to the client/ and server/ folders.
# ----------------------------------------------------------------------

RewriteEngine On
RewriteBase /

# 1. API -> Node (port 3001)
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^(.*)$ http://127.0.0.1:3001/$1 [P,L]

# 2. Map public URLs into client/dist/ (robots.txt, sitemap.xml, /catalog, etc.)
RewriteCond %{REQUEST_URI} !^/client/dist/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ client/dist/$1 [L]

# 3. React Router — non-file routes under client/dist -> index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^client/dist/.*$ client/dist/index.html [L]
